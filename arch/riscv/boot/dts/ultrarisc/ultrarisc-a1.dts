/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "ucbbar,spike-bare-dev";
	model = "ucbbar,spike-bare";

	chosen {
		bootargs = "earlycon=sbi console=ttyS0,115200 root=/dev/mmcblk0p2 rw rootfstype=ext4 rootwait";
		stdout-path = "/soc/uart0@44a00000:115200";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <75000000>;
		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv64imafdcb";
			mmu-type = "riscv,sv39";
			clock-frequency = <75000000>;

			cpu0_intc:interrupt-controller {
				#address-cells = <0x01>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <0x01>;
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x02 0x00>;
	};

	pmu {
		compatible = "riscv,pmu";
		riscv,event-to-mhpmcounters = <0x01 0x01 0x01>, <0x02 0x02 0x04>;
		riscv,event-to-mhpmevent = <0x01 0x00 0x01>, <0x02 0x00 0x04>;
		riscv,raw-event-to-mhpmcounters = <0x00 0x01 0x00 0xff 0x1f8>, <0x00 0x02 0x00 0xff 0x1f8>, 
											<0x00 0x03 0x00 0xff 0x1f8>, <0x00 0x04 0x00 0xff 0x1f8>, 
											<0x00 0x05 0x00 0xff 0x1f8>, <0x00 0x06 0x00 0xff 0x1f8>, 
											<0x00 0x07 0x00 0xff 0x1f8>, <0x00 0x08 0x00 0xff 0x1f8>, 
											<0x00 0x09 0x00 0xff 0x1f8>, <0x00 0x0a 0x00 0xff 0x1f8>, 
											<0x00 0x0b 0x00 0xff 0x1f8>, <0x00 0x0c 0x00 0xff 0x1f8>, 
											<0x00 0x0d 0x00 0xff 0x1f8>, <0x00 0x0e 0x00 0xff 0x1f8>, 
											<0x00 0x0f 0x00 0xff 0x1f8>, <0x00 0x10 0x00 0xff 0x1f8>, 
											<0x00 0x11 0x00 0xff 0x1f8>, <0x00 0x12 0x00 0xff 0x1f8>, 
											<0x00 0x13 0x00 0xff 0x1f8>, <0x00 0x14 0x00 0xff 0x1f8>, 
											<0x00 0x15 0x00 0xff 0x1f8>, <0x00 0x20 0x00 0xff 0x1f8>, 
											<0x00 0x21 0x00 0xff 0x1f8>, <0x00 0x22 0x00 0xff 0x1f8>, 
											<0x00 0x23 0x00 0xff 0x1f8>, <0x00 0x24 0x00 0xff 0x1f8>, 
											<0x00 0x25 0x00 0xff 0x1f8>, <0x00 0x26 0x00 0xff 0x1f8>, 
											<0x00 0x27 0x00 0xff 0x1f8>, <0x00 0x28 0x00 0xff 0x1f8>, 
											<0x00 0x29 0x00 0xff 0x1f8>, <0x00 0x2a 0x00 0xff 0x1f8>, 
											<0x00 0x30 0x00 0xff 0x1f8>, <0x00 0x31 0x00 0xff 0x1f8>, 
											<0x00 0x32 0x00 0xff 0x1f8>;
	};

	soc {
		compatible = "ucbbar,spike-bare-soc", "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		clint@60000000 {
			compatible = "riscv,clint0";
			interrupts-extended = <&cpu0_intc 0x03>, <&cpu0_intc 0x07>;
			reg = <0x00 0x60000000 0x00 0x100000>;
		};

		plic@50000000 {
			#interrupt-cells = <0x01>;
			#address-cells = <0x02>;
			phandle = <0x01>;
			compatible = "riscv,plic0";
			interrupt-controller;
			interrupts-extended = <&cpu0_intc 0x9>, <&cpu0_intc 0xb>;
			reg = <0x00 0x50000000 0x00 0x400000>;
			riscv,max-priority = <0x07>;
			riscv,ndev = <0x0a>;
		};

		uart0@44a00000 {
			interrupt-parent = <0x01>;
			interrupts = <0x01>;
			clock-frequency = <75000000>;
			current-speed = <115200>;
			reg = <0x00 0x44a00000 0x00 0x10000>;
			compatible = "ns16550a";
			reg-offset = <0x1000>;
			reg-shift = <0x02>;
		};

		uart1@44a10000 {
			interrupts = <0x04>;
			interrupt-parent = <0x01>;
			clock-frequency = <75000000>;
			current-speed = <115200>;
			reg = <0x00 0x44a10000 0x00 0x10000>;
			compatible = "ns16550a";
			reg-offset = <0x1000>;
			reg-shift = <0x02>;
			status = "disabled";
		};

		spi@45000000 {
			compatible = "xlnx,xps-spi-2.00.b", "xlnx,xps-spi-2.00.a";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupt-parent = <0x01>;
			interrupts = <0x02 0x02>;
			fifo-size = <0x100>;
			reg = <0x00 0x45000000 0x00 0x10000>;
			xlnx,family = "kintex7";
			xlnx,fifo-exist = <0x01>;
			xlnx,num-ss-bits = <0x01>;
			xlnx,num-transfer-bits = <0x08>;
			xlnx,sck-ratio = <0x04>;

			mmc@0 {
				compatible = "mmc-spi-slot";
				reg = <0x00>;
				spi-max-frequency = <0x17d7840>;
				voltage-ranges = <0xce4 0xce4>;
				disable-wp;
			};
		};

		ethernet@40000000 {
			compatible = "xlnx,xps-ethernetlite-1.00.a";
			device_type = "network";
			reg = <0x00 0x40000000 0x00 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x03>;
			local-mac-address = [00 18 3e 02 e3 e5];
			phy-handle = <0x04>;
			xlnx,duplex = <0x01>;
			xlnx,include-global-buffers = <0x01>;
			xlnx,include-internal-loopback = <0x00>;
			xlnx,include-mdio = <0x01>;
			xlnx,rx-ping-pong = <0x01>;
			xlnx,s-axi-id-width = <0x01>;
			xlnx,tx-ping-pong = <0x01>;
			xlnx,use-internal = <0x00>;

			mdio {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				phy@0 {
					compatible = "ethernet-phy-id0141.0E40";
					device_type = "ethernet-phy";
					phy-mode = "mii";
					status = "okay";
					// reg = <0x17>;
					reg = <0x05>;
					phandle = <0x06>;
				};
			};
		};
	};
};
